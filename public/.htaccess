# SPA routing for Apache / LiteSpeed (Hostinger).
# React Router owns the URLs, so any path that is not a real file or directory
# must serve index.html and let the client-side router match it. Without this,
# loading /top20 directly returns a server 404 instead of the app.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite requests for files or directories that actually exist
  # (assets, images, .well-known, etc).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route.
  RewriteRule . /index.html [L]
</IfModule>

# Hashed asset filenames change on every build, so they can be cached hard.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg|jpeg|gif|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html must never be cached, or users keep getting the old bundle
  # after a deploy.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
